# Copy to .env and adjust. All values shown are the defaults.

# --- API behavior ---
API_TOKEN=                     # if set, requests must send: Authorization: Bearer <API_TOKEN>
MAX_FILE_SIZE_MB=25

# --- ClamAV (clamd) ---
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_UNIX_SOCKET=             # e.g. /var/run/clamav/clamd.ctl — takes priority over host/port if set
SCAN_TIMEOUT_SECONDS=15

# --- Concurrency & rate limiting ---
MAX_CONCURRENT_SCANS=20
RATE_LIMIT_PER_MINUTE=10

# --- Zip bomb guard (.docx is a zip container) ---
ZIP_MAX_DECOMPRESSION_RATIO=100
ZIP_MAX_UNCOMPRESSED_TOTAL_MB=200

# --- Logging ---
LOG_LEVEL=INFO
